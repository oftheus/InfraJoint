# Copie para backend/.env e preencha. O .env NÃO é versionado.

# Conexão como o role app_api (login, noinherit, sem bypassrls).
# Produção: transaction pooler, porta 6543, usuário no formato <role>.<project_ref>.
#   postgresql://app_api.<project_ref>:<senha>@aws-1-<região>.pooler.supabase.com:6543/postgres
# Local:
#   postgresql://app_api:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Projeto Supabase. O issuer esperado no JWT é <SUPABASE_URL>/auth/v1.
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_JWKS_URL=https://<project_ref>.supabase.co/auth/v1/.well-known/jwks.json

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:4200,https://www.infrajoint.com.br

# --- Cloudflare R2: só usados a partir da Fase 5 ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
